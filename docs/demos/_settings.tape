# Shared look for every demo. Source this first from each tape.
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono,JetBrains Mono,DejaVu Sans Mono,monospace"
Set FontSize 16
Set Width 1000
Set Height 560
Set Padding 18
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set TypingSpeed 35ms
Set Framerate 24
Set PlaybackSpeed 1.0
